OPENROUTER_API_KEY=your-openrouter-key-here

# AUTH_SESSION_SECRET is used to sign session tokens (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit real values — .env.local is gitignored.
AUTH_SESSION_SECRET=64-hex-characters-of-random

# User accounts (email + password) are stored in the SQLite database.
# Register a new account by visiting /register in the app.
