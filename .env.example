# Copy to .env.local (gitignored) and fill in. Never commit real values.

# OpenRouter API key — used for every AI call (extraction, cover letter, bullets, questions, company brief).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# Secret used to sign session cookies (HMAC-SHA256). Must be set or every request returns 503.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=64-hex-characters-of-random
